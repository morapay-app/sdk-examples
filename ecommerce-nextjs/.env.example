# Merchant API keys (server-side only — never expose sk_* to the browser)
MORAPAY_PUBLIC_KEY=pk_test_your_public_key
MORAPAY_SECRET_KEY=sk_test_your_secret_key

# Morapay API (production default: https://api.morapay.io)
MORAPAY_BASE_URL=http://localhost:4001

# Hosted checkout canvas (widget script is served from this app at /widget/)
MORAPAY_CHECKOUT_BASE_URL=http://localhost:3002

# Optional widget script override
# MORAPAY_WIDGET_SCRIPT_URL=/widget/morapay-checkout.js
