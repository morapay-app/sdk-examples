# Required — merchant API keys (server-side only; never expose sk_* to the browser)
MORAPAY_PUBLIC_KEY=pk_test_your_public_key
MORAPAY_SECRET_KEY=sk_test_your_secret_key

# Optional — Morapay API + hosted checkout (defaults below if omitted)
MORAPAY_BASE_URL=https://api.morapay.io
MORAPAY_CHECKOUT_BASE_URL=https://checkout.morapay.io

# Local Morapay stack (uncomment instead of production URLs above):
# MORAPAY_BASE_URL=http://localhost:4001
# MORAPAY_CHECKOUT_BASE_URL=http://localhost:3002

# MORAPAY_WIDGET_SCRIPT_URL=/widget/morapay-checkout.js
